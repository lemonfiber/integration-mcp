          },
          "type": "object"
        },
        "required": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "const": "object",
          "type": "string"
        }
      },
      "required": [
        "properties",
        "type"
      ],
      "type": "object"
    }
  },
  "required": [
